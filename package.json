{
  "name": "penn-notes",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Penn Notes — VitePress static site",
  "scripts": {
    "ingest": "node scripts/ingest-sync.mjs",
    "sync:news": "node scripts/sync-news.mjs",
    "news:daily": "node scripts/generate-daily-news.mjs",
    "news:weekly": "node scripts/generate-weekly-news.mjs",
    "news:images": "node scripts/resolve-news-images.mjs",
    "news:feed": "node scripts/build-news-feed.mjs",
    "build:home": "node scripts/build-home.mjs",
    "build:redirects": "node scripts/build-redirects.mjs",
    "prebuild": "npm run ingest && npm run sync:news && npm run build:home",
    "dev": "npm run ingest && npm run sync:news && npm run build:home && vitepress dev website",
    "build": "vitepress build website && npm run build:redirects",
    "preview": "vitepress preview website"
  },
  "devDependencies": {
    "rss-parser": "^3.13.0",
    "undici": "^6.28.0",
    "vitepress": "^1.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "medium-zoom": "^1.1.0"
  }
}
